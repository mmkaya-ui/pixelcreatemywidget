{
  "v": 1,
  "name": "Holiday countdown",
  "size": { "cols": 2, "rows": 1 },
  "calc": { "left": "days(today(), date('2026-12-24'))" },
  "root": {
    "t": "row", "pad": 12, "gap": 10, "cross": "center",
    "kids": [
      { "t": "text", "text": "{left}", "style": "display", "bold": true, "color": "primary" },
      { "t": "col", "kids": [
        { "t": "text", "text": "{left == 1 ? 'day' : 'days'} to go", "style": "title" },
        { "t": "text", "text": "Thu 24 Dec", "style": "caption", "color": "muted" }
      ] }
    ]
  }
}
