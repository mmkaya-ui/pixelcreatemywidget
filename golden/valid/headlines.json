{
  "v": 1,
  "name": "Headlines",
  "about": "World news from the BBC, with pictures. Tap a story to read it.",
  "size": { "cols": 4, "rows": 3 },
  "sources": { "news": { "use": "feed", "with": { "url": "https://feeds.bbci.co.uk/news/world/rss.xml" }, "every": "1h" } },
  "root": {
    "t": "col", "pad": 12, "gap": 8,
    "kids": [
      { "t": "row", "align": "between", "cross": "center", "kids": [
        { "t": "text", "text": "{coalesce(news.title, 'Headlines')}", "style": "label", "color": "muted", "lines": 1 },
        { "t": "icon", "icon": "refresh", "iconSize": 18, "color": "muted", "tap": { "do": "refresh" } }
      ] },
      { "t": "list", "of": "news.items", "limit": 5, "gap": 8, "grow": 1, "empty": "No stories yet",
        "item": {
          "t": "row", "gap": 10, "cross": "center", "tap": { "do": "open_source", "source": "news" },
          "kids": [
            { "t": "image", "src": "source:it.image", "fit": "cover", "w": 56, "h": 42, "radius": 8, "if": "it.image", "from": "m" },
            { "t": "col", "grow": 1, "kids": [
              { "t": "text", "text": "{it.title}", "style": "body", "lines": 2 },
              { "t": "text", "text": "{fmt(it.published, 'HH:mm')}", "style": "caption", "color": "muted" }
            ] }
          ]
        } }
    ]
  }
}
